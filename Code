<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>日本語动词变化练习题</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;600&family=Noto+Sans+SC:wght@300;400;500&display=swap');

  :root {
    --ink: #1a1a2e;
    --red: #c0392b;
    --gold: #b8860b;
    --paper: #fdf6e3;
    --paper2: #f5edd6;
    --border: #c8b89a;
    --correct: #27ae60;
    --wrong: #c0392b;
    --accent: #2c3e6b;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--paper);
    font-family: 'Noto Sans SC', sans-serif;
    color: var(--ink);
    min-height: 100vh;
    background-image: 
      repeating-linear-gradient(transparent, transparent 31px, var(--border) 31px, var(--border) 32px);
    background-attachment: fixed;
  }

  .header {
    background: var(--accent);
    color: #fff;
    padding: 24px 32px;
    text-align: center;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }

  .header h1 {
    font-family: 'Noto Serif JP', serif;
    font-size: 1.6rem;
    letter-spacing: 0.1em;
    margin-bottom: 6px;
  }

  .progress-bar-wrap {
    background: rgba(255,255,255,0.2);
    border-radius: 20px;
    height: 8px;
    margin: 10px auto 0;
    max-width: 500px;
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    background: #f0c040;
    border-radius: 20px;
    transition: width 0.4s ease;
    width: 0%;
  }

  .stats {
    display: flex;
    justify-content: center;
    gap: 32px;
    margin-top: 8px;
    font-size: 0.85rem;
    opacity: 0.9;
  }

  .stats span { font-weight: 500; }
  .stats .correct-count { color: #7effa0; }
  .stats .wrong-count { color: #ff9898; }

  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 20px 60px;
  }

  .section-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 1.1rem;
    color: var(--accent);
    border-left: 4px solid var(--gold);
    padding-left: 12px;
    margin: 36px 0 16px;
    letter-spacing: 0.05em;
  }

  .question-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 20px 24px;
    margin-bottom: 16px;
    box-shadow: 2px 3px 0 var(--border);
    transition: all 0.2s;
    position: relative;
  }

  .question-card.answered-correct {
    border-color: var(--correct);
    box-shadow: 2px 3px 0 var(--correct);
    background: #f0fff4;
  }

  .question-card.answered-wrong {
    border-color: var(--wrong);
    box-shadow: 2px 3px 0 var(--wrong);
    background: #fff5f5;
  }

  .q-number {
    font-size: 0.75rem;
    color: #888;
    margin-bottom: 6px;
    font-family: monospace;
  }

  .q-text {
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 14px;
    color: var(--ink);
  }

  .q-text .jp {
    font-family: 'Noto Serif JP', serif;
    font-size: 1.2rem;
    color: var(--accent);
  }

  .q-text .blank {
    display: inline-block;
    border-bottom: 2px solid var(--gold);
    min-width: 60px;
    color: var(--gold);
    font-style: italic;
    padding: 0 4px;
  }

  .input-row {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  .answer-input {
    flex: 1;
    min-width: 140px;
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 8px 12px;
    font-size: 1rem;
    font-family: 'Noto Serif JP', serif;
    background: var(--paper);
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s;
  }

  .answer-input:focus { border-color: var(--accent); }

  .answer-input:disabled {
    background: #f0f0f0;
    cursor: not-allowed;
  }

  .btn {
    padding: 8px 18px;
    border: none;
    border-radius: 3px;
    font-size: 0.9rem;
    font-family: 'Noto Sans SC', sans-serif;
    cursor: pointer;
    transition: all 0.15s;
    font-weight: 500;
  }

  .btn-check {
    background: var(--accent);
    color: #fff;
  }

  .btn-check:hover { background: #1a2550; }

  .btn-show {
    background: var(--border);
    color: var(--ink);
    font-size: 0.82rem;
  }

  .btn-show:hover { background: #bbb; }

  .feedback {
    margin-top: 10px;
    font-size: 0.92rem;
    padding: 8px 12px;
    border-radius: 3px;
    display: none;
  }

  .feedback.correct {
    display: block;
    background: #d4edda;
    color: #155724;
    border-left: 3px solid var(--correct);
  }

  .feedback.wrong {
    display: block;
    background: #f8d7da;
    color: #721c24;
    border-left: 3px solid var(--wrong);
  }

  .feedback .answer-reveal {
    font-family: 'Noto Serif JP', serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--correct);
  }

  .tip {
    font-size: 0.8rem;
    color: #888;
    margin-top: 4px;
  }

  .result-banner {
    display: none;
    background: var(--accent);
    color: #fff;
    text-align: center;
    padding: 40px 24px;
    border-radius: 6px;
    margin-top: 40px;
  }

  .result-banner h2 {
    font-family: 'Noto Serif JP', serif;
    font-size: 1.8rem;
    margin-bottom: 12px;
  }

  .result-banner .score {
    font-size: 3rem;
    font-weight: 600;
    color: #f0c040;
  }

  .btn-reset {
    margin-top: 20px;
    padding: 12px 32px;
    background: #f0c040;
    color: var(--ink);
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    cursor: pointer;
    font-family: 'Noto Sans SC', sans-serif;
    font-weight: 500;
  }

  .tag {
    display: inline-block;
    font-size: 0.7rem;
    padding: 2px 7px;
    border-radius: 10px;
    margin-left: 8px;
    vertical-align: middle;
    font-weight: 500;
  }

  .tag-godan { background: #e8f4fd; color: #2980b9; }
  .tag-ichidan { background: #eafaf1; color: #1e8449; }
  .tag-ka { background: #fdf2e9; color: #ca6f1e; }
  .tag-sa { background: #f9ebea; color: #c0392b; }
  .tag-classify { background: #f4ecf7; color: #7d3c98; }
  .tag-te { background: #fef9e7; color: #b7950b; }
  .tag-exist { background: #eaf2ff; color: #2471a3; }
</style>
</head>
<body>

<div class="header">
  <h1>日语动词变化综合练习</h1>
  <div class="stats">
    <span>共 <strong id="total-count">0</strong> 题</span>
