// ===================== RENDER =====================
let totalQuestions = 0;
let correctCount = 0;
let wrongCount = 0;
let doneCount = 0;

function normalize(str) {
  return str.trim()
    .replace(/\s+/g, '')
    .replace(/[（）]/g, match => match === '（' ? '(' : ')')
    .toLowerCase();
}

function checkAnswer(userAns, correctList) {
  const u = normalize(userAns);
  return correctList.some(a => normalize(a) === u);
}

function buildQuiz() {
  const container = document.getElementById('quiz-container');
  let qNum = 0;

  sections.forEach(section => {
    const secDiv = document.createElement('div');

    const titleEl = document.createElement('div');
    titleEl.className = 'section-title';
    titleEl.textContent = section.title;
    secDiv.appendChild(titleEl);

    section.questions.forEach(q => {
      qNum++;
      totalQuestions++;
      const card = document.createElement('div');
      card.className = 'question-card';
      card.id = 'q' + qNum;

      card.innerHTML = `
        <div class="q-number">Q${qNum} <span class="tag ${section.tag}">${section.tagLabel}</span></div>
        <div class="q-text">${q.q}</div>
        <div class="input-row">
          <input type="text" class="answer-input" placeholder="输入答案（日文/中文均可）" data-num="${qNum}">
          <button class="btn btn-check" onclick="submitAnswer(${qNum})">确认</button>
          <button class="btn btn-show" onclick="showAnswer(${qNum})">显示答案</button>
        </div>
        <div class="feedback" id="fb${qNum}"></div>
        <div class="tip" id="tip${qNum}" style="display:none">💡 ${q.hint}</div>
      `;

      // Store answer data
      card.dataset.answers = JSON.stringify(q.a);
      card.dataset.hint = q.hint;

      // Enter key support
      const input = card.querySelector('.answer-input');
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') submitAnswer(qNum);
      });

      secDiv.appendChild(card);
    });

    container.appendChild(secDiv);
  });

  // Add result banner
  const banner = document.createElement('div');
  banner.className = 'result-banner';
  banner.id = 'result-banner';
  banner.innerHTML = `
    <h2>🎉 全部完成！</h2>
    <div class="score" id="final-score">0/0</div>
    <p style="margin-top:12px;opacity:0.85">继续加油，熟能生巧！</p>
    <button class="btn-reset" onclick="resetQuiz()">重新练习</button>
  `;
  container.appendChild(banner);

  updateStats();
}

window.submitAnswer = function(num) {
  const card = document.getElementById('q' + num);
  const input = card.querySelector('.answer-input');
  const fb = document.getElementById('fb' + num);
  const tip = document.getElementById('tip' + num);

  if (input.disabled) return;

  const userAns = input.value;
  if (!userAns.trim()) { input.focus(); return; }

  const answers = JSON.parse(card.dataset.answers);
  const isCorrect = checkAnswer(userAns, answers);

  input.disabled = true;
  card.querySelector('.btn-check').disabled = true;
  card.querySelector('.btn-show').disabled = true;
  tip.style.display = 'block';
  doneCount++;

  if (isCorrect) {
    correctCount++;
    card.classList.add('answered-correct');
    fb.className = 'feedback correct';
    fb.innerHTML = `✓ 正确！答案：<span class="answer-reveal">${answers[0]}</span>`;
  } else {
    wrongCount++;
    card.classList.add('answered-wrong');
    fb.className = 'feedback wrong';
    fb.innerHTML = `✗ 错误。您的答案：「${userAns}」<br>正确答案：<span class="answer-reveal">${answers.join(' / ')}</span>`;
  }

  updateStats();
  if (doneCount === totalQuestions) showResult();
};

window.showAnswer = function(num) {
  const card = document.getElementById('q' + num);
  const input = card.querySelector('.answer-input');
  const fb = document.getElementById('fb' + num);
  const tip = document.getElementById('tip' + num);

  if (input.disabled) return;

  const answers = JSON.parse(card.dataset.answers);
  input.disabled = true;
  card.querySelector('.btn-check').disabled = true;
  card.querySelector('.btn-show').disabled = true;
  tip.style.display = 'block';
  doneCount++;
  wrongCount++; // counts as missed

  card.classList.add('answered-wrong');
  fb.className = 'feedback wrong';
  fb.innerHTML = `📖 答案：<span class="answer-reveal">${answers.join(' / ')}</span>`;

  updateStats();
  if (doneCount === totalQuestions) showResult();
};

function updateStats() {
  document.getElementById('total-count').textContent = totalQuestions;
  document.getElementById('correct-count').textContent = correctCount;
  document.getElementById('wrong-count').textContent = wrongCount;
  document.getElementById('done-count').textContent = doneCount;
  const pct = totalQuestions ? (doneCount / totalQuestions * 100) : 0;
  document.getElementById('progress-bar').style.width = pct + '%';
}

function showResult() {
  const banner = document.getElementById('result-banner');
  banner.style.display = 'block';
  document.getElementById('final-score').textContent = `${correctCount} / ${totalQuestions}`;
  banner.scrollIntoView({ behavior: 'smooth' });
}

window.resetQuiz = function() {
  correctCount = 0; wrongCount = 0; doneCount = 0; totalQuestions = 0;
  document.getElementById('quiz-container').innerHTML = '';
  buildQuiz();
  window.scrollTo({ top: 0, behavior: 'smooth' });
};

buildQuiz();
</script>
