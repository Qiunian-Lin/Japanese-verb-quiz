    <span class="wrong-count">✗ 错误 <strong id="wrong-count">0</strong></span>
    <span>已作答 <strong id="done-count">0</strong></span>
  </div>
  <div class="progress-bar-wrap">
    <div class="progress-bar" id="progress-bar"></div>
  </div>
</div>

<div class="container" id="quiz-container"></div>

